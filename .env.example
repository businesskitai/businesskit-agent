# BusinessKit Model Context Protocol (MCP) Server Configuration

# Turso Database Connection (Required for inventory, billing, CRM, and CMS operations)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: active profile ID (auto-detected from database if left empty)
PROFILE_ID=

# Supported aliases:
# TURSO_URL=libsql://your-database.turso.io
# TURSO_TOKEN=your-turso-auth-token
# BK_TURSO_URL=libsql://your-database.turso.io
# BK_TURSO_TOKEN=your-turso-auth-token
