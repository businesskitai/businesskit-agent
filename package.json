{
  "name": "@businesskit/agent",
  "version": "1.0.6",
  "description": "Official Model Context Protocol (MCP) server & agent toolbelt for BusinessKit — POS, invoicing, inventory restock, CRM, and website publishing.",
  "type": "module",
  "main": "dist/server.js",
  "module": "dist/server.js",
  "types": "dist/server.d.ts",
  "mcpName": "io.github.businesskitai/agent",
  "bin": {
    "bk": "bin/businesskit.js",
    "businesskit": "bin/businesskit.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "commands",
    "skills",
    "templates",
    "scripts",
    "rules",
    "assets",
    "plugin.json",
    "mcp_config.json",
    "server.json",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "LICENSE",
    "README.md",
    ".cursorrules",
    ".claude-plugin",
    ".cursor-plugin",
    ".superconsole-plugin"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "setup": "bash ./scripts/setup.sh",
    "setup:ts": "npx tsx scripts/setup.ts",
    "update": "bash ./scripts/update.sh",
    "prepack": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude-cowork",
    "antigravity",
    "cursor",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "business-agent",
    "businesskit",
    "turso"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/businesskitai/businesskit-agent.git"
  },
  "homepage": "https://github.com/businesskitai/businesskit-agent#readme",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10"
  }
}
